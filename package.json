{
  "name": "heurist-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Heurist Explorer and isolated data, graph, map and timeline presentation applications",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#shared": "./shared/src/index.js",
    "#shared/api": "./shared/src/api/index.js",
    "#shared/config": "./shared/src/config/index.js",
    "#shared/contracts": "./shared/src/contracts/index.js",
    "#shared/host": "./shared/src/host/index.js",
    "#shared/ui": "./shared/src/ui/index.js",
    "#shared/utils": "./shared/src/utils/index.js",
    "#shared/widgets": "./shared/src/widgets/index.js",
    "#shared/*": "./shared/src/*"
  },
  "scripts": {
    "dev": "vite --mode explorer",
    "dev:explorer": "vite --mode explorer",
    "dev:data": "vite --mode data",
    "dev:graph": "vite --mode graph",
    "dev:map": "vite --mode map",
    "dev:timeline": "vite --mode timeline",
    "build": "npm run build:all",
    "build:explorer": "vite build --mode explorer",
    "build:data": "vite build --mode data",
    "build:graph": "vite build --mode graph",
    "build:map": "vite build --mode map",
    "build:timeline": "vite build --mode timeline",
    "build:all": "node scripts/build-all.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "node --experimental-loader ./scripts/cssLoader.mjs --test",
    "test:shared": "node --experimental-loader ./scripts/cssLoader.mjs --test \"shared/test/**/*.test.js\"",
    "test:explorer": "node --experimental-loader ./scripts/cssLoader.mjs --test \"apps/explorer/test/**/*.test.js\"",
    "test:data": "node --experimental-loader ./scripts/cssLoader.mjs --test \"apps/data/test/**/*.test.js\"",
    "test:graph": "node --experimental-loader ./scripts/cssLoader.mjs --test \"apps/graph/test/**/*.test.js\"",
    "test:map": "node --experimental-loader ./scripts/cssLoader.mjs --test \"apps/map/test/**/*.test.js\"",
    "test:timeline": "node --experimental-loader ./scripts/cssLoader.mjs --test \"apps/timeline/test/**/*.test.js\"",
    "deploy:explorer": "node scripts/deploy-module.mjs explorer",
    "deploy:data": "node scripts/deploy-module.mjs data",
    "deploy:graph": "node scripts/deploy-module.mjs graph",
    "deploy:map": "node scripts/deploy-module.mjs map",
    "deploy:timeline": "node scripts/deploy-module.mjs timeline",
    "deploy:all": "node scripts/deploy-module.mjs all"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "datatables.net-buttons": "^3.2.5",
    "datatables.net-buttons-dt": "^3.2.5",
    "datatables.net-dt": "^2.3.5",
    "dom-to-image": "^2.6.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-bookmarks": "^0.5.1",
    "leaflet-control-geocoder": "^4.0.0",
    "leaflet-draw": "^1.0.4",
    "leaflet-providers": "^3.0.0",
    "leaflet-tilelayer-pixelfilter": "^1.3.2",
    "leaflet.browser.print": "^2.0.2",
    "leaflet.markercluster": "^1.5.3",
    "pdfmake": "^0.2.23",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "vis-timeline": "^8.5.4",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "vite": "^8.1.1"
  }
}
