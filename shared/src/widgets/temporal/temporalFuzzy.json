{
  "format": "heurist-edit-form/1",
  "groups": [
    {
      "id": "dates", "type": "group", "columns": 2, "slot": "fuzzySet",
      "help": "Enter only the known values, starting with the year: year (eg. 1624) or ISO date (yyyy-mm or yyyy-mm-dd). Use minus (-) for BCE dates (eg. -375 for 375 BCE)",
      "children": [
        { "name": "tpq", "type": "date", "temporal": false, "label": "Terminus Post Quem", "req": "required", "width": 16,
          "help": "The earliest possible date" },
        { "name": "pdb", "type": "date", "temporal": false, "label": "Probable begin", "width": 16 },
        { "name": "pde", "type": "date", "temporal": false, "label": "Probable end", "width": 16 },
        { "name": "taq", "type": "date", "temporal": false, "label": "Terminus Ante Quem", "req": "required", "width": 16,
          "help": "The latest possible date" }
      ]
    },
    {
      "id": "profiles", "type": "group", "columns": 2,
      "help": "Distribution of the likelihood of the date between the terminus date and the probable date (if in doubt, choose flat: any point is equally likely)",
      "children": [
        { "name": "startProfile", "type": "enum", "mode": "select", "label": "Start profile", "clearable": false, "default": 0,
          "terms": [
            { "id": 0, "label": "Flat" },
            { "id": 1, "label": "Central tendency" },
            { "id": 2, "label": "Slow start" },
            { "id": 3, "label": "Slow finish" }
          ] },
        { "name": "endProfile", "type": "enum", "mode": "select", "label": "End profile", "clearable": false, "default": 0,
          "terms": [
            { "id": 0, "label": "Flat" },
            { "id": 1, "label": "Central tendency" },
            { "id": 2, "label": "Slow start" },
            { "id": 3, "label": "Slow finish" }
          ] }
      ]
    },
    {
      "id": "source", "type": "group",
      "children": [
        { "name": "determination", "type": "enum", "label": "Type of determination", "help": "How were the dates arrived at?",
          "clearable": false, "default": 0,
          "terms": [
            { "id": 0, "label": "Unknown" },
            { "id": 1, "label": "Attested" },
            { "id": 2, "label": "Conjecture" },
            { "id": 3, "label": "Measurement" }
          ] },
        { "name": "comment", "type": "freetext", "label": "Comment / original information",
          "help": "Stored with the date to record the original values entered" }
      ]
    }
  ]
}
