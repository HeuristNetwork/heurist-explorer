        {
          "name": "options.ui.showOptions",
          "type": "boolean",
          "req": "forbidden",
          "default": true,
          "forced": {
            "website": false,
            "publication": false
          }
        },
        {
          "name": "options.ui.showPublish",
          "type": "boolean",
          "req": "forbidden",
