          "req": "recommended",
          "terms": [],
          "default": null,
          "mode": "select",
          "termsSource": "smartyTemplates",
          "emptyLabel": "Built-in renderer",
          "showWhen": {
            "config.defaults.viewMode": [
              "card",
              "row"
            ]
          }
        },
        {
          "name": "config.defaults.viewTemplate",
          "type": "enum",
          "label": "Extended view template",
          "req": "recommended",
          "terms": [
            {
              "id": "standard",
              "label": "Standard (Legacy)"
            }
          ],
          "default": null,
          "mode": "select",
          "termsSource": "smartyTemplates",
          "emptyLabel": "Built-in",
          "simplified": {
            "value": null
          }
        },
        {
          "name": "config.defaults.popupTemplate",
          "type": "enum",
          "label": "Popup template",
          "req": "recommended",
          "terms": [
            {
              "id": "none",
              "label": "None"
            },
            {
              "id": "standard",
              "label": "Standard (Legacy)"
            }
          ],
          "default": null,
          "mode": "select",
          "termsSource": "smartyTemplates",
          "emptyLabel": "Built-in",
          "simplified": {
            "value": null
