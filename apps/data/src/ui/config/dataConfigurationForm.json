          "default": "card",
          "mode": "select",
          "clearable": false
        },
        {
          "name": "config.defaults.pageSize",
          "type": "enum",
          "label": "Page size",
          "req": "recommended",
          "terms": [
            {
              "id": 50,
              "label": "50"
            },
            {
              "id": 100,
              "label": "100"
            },
            {
              "id": 500,
              "label": "500"
            },
            {
              "id": 1000,
              "label": "1000"
            },
            {
              "id": 5000,
              "label": "5000"
            }
          ],
          "default": 100,
          "mode": "select",
          "clearable": false
        },
        {
          "name": "config.defaults.fontSize",
          "type": "integer",
          "label": "Font size",
          "req": "recommended",
