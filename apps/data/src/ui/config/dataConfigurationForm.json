          "req": "recommended",
          "terms": [
            {
              "id": "list",
              "label": "List"
            },
            {
              "id": "card",
              "label": "Cards"
            },
            {
              "id": "row",
              "label": "Row"
            },
            {
              "id": "big",
              "label": "Extended"
            },
            {
              "id": "datatable",
              "label": "Table"
            }
